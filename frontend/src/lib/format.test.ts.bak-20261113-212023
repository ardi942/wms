import { describe, expect, it } from 'vitest'
import { formatCurrency, formatQty, statusLabel, statusTone } from './format'

describe('format helpers', () => {
  it('formats currency with two decimals', () => {
    expect(formatCurrency(1234.5)).toBe('$1,234.50')
  })
  it('formats integers', () => {
    expect(formatQty(12000)).toBe('12,000')
  })
  it('labels statuses', () => {
    expect(statusLabel('PARTIALLY_FULFILLED')).toBe('Partially Fulfilled')
    expect(statusTone('REJECTED')).toBe('red')
  })
})
