type Handler struct{ svc *Service }

func NewHandler(svc *Service) *Handler { return &Handler{svc: svc} }

func (h *Handler) Dashboard(c *gin.Context) {
	id := httpx.MustIdentity(c)
	out, err := h.svc.Dashboard(c.Request.Context(), &httpxIdentity{
		ID: id.ID, Role: id.Role, DepartmentID: id.DepartmentID,
	})
	if err != nil {
		httpx.WriteError(c, err)
		return
	}
	httpx.OK(c, out)
}

func (h *Handler) Inventory(c *gin.Context) {
	f, err := parseFilter(c)
	if err != nil {
		httpx.WriteError(c, err)
		return
	}
	p, perr := httpx.ParsePagination(c)
	if perr != nil {
		httpx.WriteError(c, perr)
		return
	}
	f.Page, f.PageSize = p.Page, p.PageSize
	rows, total, qerr := h.svc.Inventory(c.Request.Context(), f)
	if qerr != nil {
		httpx.WriteError(c, qerr)
		return
	}
	httpx.List(c, rows, httpx.NewMeta(p, total))
}

